# AgriMart ignore rules for both frontend and backend

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
backend/dist/
.output/
.vinxi/
.nitro/
.tanstack/
frontend/.tanstack/
.wrangler/
frontend/.wrangler/

# Environment files with secrets
.env
.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

# Cloudflare / local runtime secrets
.dev.vars
frontend/.dev.vars
backend/.dev.vars

# Logs
logs/
*.log
frontend/*.log
backend/*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
frontend/npm-debug.log*
backend/npm-debug.log*

# Runtime/cache/test output
.cache/
coverage/
frontend/.cache/
frontend/coverage/
backend/.cache/
backend/coverage/

# Nested Git backup created while converting frontend into a normal folder
.git.backup/
frontend/.git.backup/

# Local database dumps and temporary files
*.dump
*.sql.gz
*.tmp
tmp/
temp/

# OS/editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
